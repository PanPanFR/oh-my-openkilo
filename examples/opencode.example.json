{
  "$schema": "https://opencode.ai/config.json",
  "model": "<YOUR_DEFAULT_MODEL>",
  "small_model": "<YOUR_SMALL_MODEL>",
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "mcp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow"
  },
  "disabled_providers": [],
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "opencode": {},
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://9router.panpan.my.id/v1",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {}
    }
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "env": {
        "AGENTMEMORY_SERVER_URL": "http://localhost:3111"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "perplexity": {
      "type": "local",
      "command": ["python", "C:/path/to/perplexity-mcpserver-proxy/main.py"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "remotion": {
      "type": "local",
      "command": ["npx", "-y", "remotion-mcp"],
      "enabled": false
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:GOOGLE_API_KEY}"
      },
      "enabled": true
    },
    "supabase-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "{env:SUPABASE_ACCESS_TOKEN}"
      ],
      "enabled": false
    },
    "tinypuppet": {
      "type": "local",
      "command": ["python", "-m", "tinypuppet.mcp_server"],
      "enabled": false
    }
  },
  "instructions": [
    "rules/agentmemory.md",
    "rules/graphify.md",
    "rules/skill-reminder.md",
    "rules/delegation.md",
    "rules/language.md",
    "rules/communication-style.md",
    "rules/workers.md"
  ],
  "lsp": true
}
