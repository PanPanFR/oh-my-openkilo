{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free#max",
  "small_model": "opencode/deepseek-v4.1-flash-free#max",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "title": {
      "model": "opencode/deepseek-v4.1-flash-free#max"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:NINE_ROUTER_BASE_URL}",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {
        "ag/gemini-3.8-flash-high": {
          "name": "gemini-3.8-flash-high",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "video",
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "modelID": "ag/gemini-3.8-flash-high"
        },
        "ag/claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "modelID": "ag/claude-sonnet-4-6"
        },
        "ag/claude-opus-4-6-thinking": {
          "name": "claude-opus-4-6-thinking",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "modelID": "ag/claude-opus-4-6-thinking"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "agentmemory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@agentmemory/mcp"
        ],
        "environment": {
          "AGENTMEMORY_SERVER_URL": "http://127.0.0.1:3111",
          "AGENTMEMORY_TOOLS": "core"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true
      },
      "magicuidesign-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@magicuidesign/mcp@latest"
        ],
        "disabled": true
      },
      "reactbits": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "reactbits-dev-mcp-server"
        ],
        "disabled": true
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "openai",
        "effect": "deny"
      }
    ]
  },
  "lsp": true
}
