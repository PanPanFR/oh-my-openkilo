{
  "$schema": "https://opencode.ai/config.json",
  "model": "<YOUR_DEFAULT_MODEL>",
  "small_model": "<YOUR_SMALL_MODEL>",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  },
  "plugins": [
    "./plugins/agentmemory-capture.ts",
    "./plugins/recall-first.ts",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "./plugins/graphify.ts",
    "./plugins/rtk.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "providers": {
    "9router": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://<YOUR_ROUTER_BASE_URL>/v1",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {}
    }
  },
  "mcp": {
    "servers": {
      "agentmemory": {
        "type": "local",
        "command": ["npx", "-y", "@agentmemory/mcp"],
        "environment": {
          "AGENTMEMORY_SERVER_URL": "http://127.0.0.1:3111",
          "AGENTMEMORY_TOOLS": "core"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
        "disabled": true
      }
    }
  },
  "lsp": true
}
