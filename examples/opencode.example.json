{
  "$schema": "https://opencode.ai/config.json",
  "model": "<YOUR_DEFAULT_MODEL>",
  "small_model": "<YOUR_SMALL_MODEL>",
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "mcp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow"
  },
  "disabled_providers": [],
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js",
    "./plugins/graphify.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "opencode": {},
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://<YOUR_ROUTER_BASE_URL>/v1",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {}
    }
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "environment": {
        "AGENTMEMORY_SERVER_URL": "http://127.0.0.1:3111",
        "AGENTMEMORY_TOOLS": "core"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "instructions": [
    "rules/skill-reminder.md",
    "rules/language.md",
    "rules/communication-style.md"
  ],
  "lsp": true
}
